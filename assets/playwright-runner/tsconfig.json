{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "playwright.config.ts",
    "support/**/*.ts",
    "fixtures/**/*.ts",
    "flows/**/*.ts",
    "tests/**/*.ts",
    "support/**/*.mjs"
  ]
}
