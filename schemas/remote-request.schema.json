{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uia-remote-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "uia-remote-request.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "case_id",
          "assertion_id",
          "expected",
          "url",
          "method",
          "conditions",
          "saved_at",
          "earliest_check_at",
          "deadline",
          "timeout_ms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "assertion_id": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "method": {
            "const": "GET"
          },
          "saved_at": {
            "type": "string",
            "format": "date-time"
          },
          "earliest_check_at": {
            "type": "string",
            "format": "date-time"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "restored_at": {
            "type": "string",
            "format": "date-time"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          },
          "cache_bust": {"type": "boolean"},
          "immediate": {"type": "boolean"},
          "max_latency_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "value"
              ],
              "properties": {
                "op": {
                  "enum": [
                    "contains",
                    "equals",
                    "ordered_pairs"
                  ]
                },
                "section": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "string",
                    "array"
                  ],
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
